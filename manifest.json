{
  "manifest_version": 3,
  "name": "Stash Screen Recorder & Screenshot",
  "short_name": "Stash",
  "version": "2.0.0",
  "description": "Record. Screenshot. Stash. A free, offline screen recorder that keeps everything on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stash — Screen Recorder & Screenshot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "tabCapture",
    "activeTab",
    "scripting",
    "offscreen",
    "downloads",
    "alarms",
    "notifications"
  ],
  "optional_permissions": [
    "identity"
  ],
  "optional_host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "307650313190-fi16i8qfo63ot0f46m84v06j6e6ifc3b.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
